{
  "name": "@chartmd/core",
  "version": "0.1.0",
  "description": "Generate SVG charts for Markdown documentation.",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
