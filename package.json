{
  "name": "@leracherry/chartmd",
  "version": "0.4.0",
  "description": "Markdown-native charts for React, styled by your Markdown theme.",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "sideEffects": [
    "./style.css"
  ],
  "files": [
    "dist",
    "style.css",
    "README.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./style.css"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "pnpm build && node examples/demo/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm build && pnpm test && pnpm typecheck && pnpm lint && pnpm format:check",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leracherry/chart.md.git"
  },
  "homepage": "https://github.com/leracherry/chart.md#readme",
  "bugs": {
    "url": "https://github.com/leracherry/chart.md/issues"
  },
  "keywords": [
    "markdown",
    "react",
    "react-markdown",
    "remark",
    "charts",
    "data-visualization"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
